PORT=5000
NODE_ENV=development
MONGO_URI=
CLIENT_URL=https://www.babycureindia.com
CLIENT_URLS=https://www.babycureindia.com,https://babycureindia.com
JWT_SECRET=
JWT_EXPIRES_IN=30d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_AUTO_PICKUP=true
SHIPROCKET_AUTO_MAX_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_ITEM_WEIGHT_KG=0.25
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=10
SHIPROCKET_WEBHOOK_TOKEN=
# Configure Shiprocket's webhook URL as: https://YOUR_API_DOMAIN/api/shipment-events
# Use SHIPROCKET_WEBHOOK_TOKEN as Shiprocket's x-api-key security token.
TRACKING_SYNC_MIN_INTERVAL_MS=15000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REDIS_URL=
LOG_LEVEL=info
